{
  "name": "dsh-electron",
  "version": "1.3.2",
  "description": "DSH Web GUI 的独立 Electron 窗口封装（含服务生命周期管理、归属校验与安全加固）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-isolation=none \"tests/*.test.js\"",
    "test:watch": "node --test --test-isolation=none --watch \"tests/*.test.js\"",
    "selftest": "node tools/selftest.js",
    "gen-icon": "node tools/gen-icon.js",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "stop": "node tools/stop-dsh.js",
    "stop:dry": "node tools/stop-dsh.js --dry-run"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "local.dsh.electron",
    "productName": "DSH Desktop",
    "extraMetadata": {
      "productName": "DSH Desktop"
    },
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "33.4.11",
    "npmRebuild": false
  },
  "author": "DSH Electron",
  "private": true
}
